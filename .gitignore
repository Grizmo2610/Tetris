# =============================================================================
# Tetris Platform — .gitignore
# =============================================================================

# Environment & Secrets
.env
.env.local
.env.*.local
.env.production
.env.development

# Node / JavaScript
node_modules/
frontend/node_modules/
backend/node_modules/

dist/
dist-server/
frontend/dist/
backend/dist/

.cache/
.parcel-cache/
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime
pids/
*.pid
*.seed
*.pid.lock

# Python (ai-training)
# Virtual environments
ai-training/venv/
ai-training/.venv/
ai-training/env/
ai-training/.env/

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Distribution / packaging
ai-training/dist/
ai-training/build/
ai-training/*.egg-info/
ai-training/.eggs/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# ML artifacts
ai-training/checkpoints/
ai-training/exports/
ai-training/runs/
ai-training/wandb/
ai-training/lightning_logs/

# Model weights (too large for git — stored in Cloudflare R2)
*.pt
*.pth
*.ckpt
*.onnx
*.ort

# Dataset files
*.csv
*.json.gz
*.pkl
*.npy
*.npz
*.h5
*.hdf5

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Testing
coverage/
.nyc_output/
*.lcov

# Misc
*.bak
*.tmp
*.temp

*.zip
*.sql

# Unignore ai-training/env/ (it's source code, not a venv)
!ai-training/env/
!ai-training/env/*
ai-training

pack.ps1